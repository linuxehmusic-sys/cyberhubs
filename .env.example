# Mapbox Token (Required for 3D Mapping)
VITE_MAPBOX_TOKEN=

# OpenCellID API Key (Required for Cellular Tracking)
VITE_OPENCELLID_API_KEY=

# Mapillary Client ID (Required for Video Geolocation)
VITE_MAPILLARY_CLIENT_ID=

# Sentinel Hub Client ID/Secret (Required for Satellite Imagery)
VITE_SENTINEL_HUB_CLIENT_ID=
VITE_SENTINEL_HUB_CLIENT_SECRET=

# ACRCloud Access Key/Secret (Required for Audio OSINT)
VITE_ACRCLOUD_ACCESS_KEY=
VITE_ACRCLOUD_ACCESS_SECRET=
VITE_ACRCLOUD_HOST=
